{
  "manifest_version": 3,
  "name": "Claw Studio — Creator Content Exporter",
  "version": "3.1.0",
  "description": "Export publicly visible notes, images, tags, and engagement data for content research and analysis. Bring your own AI API key.",
  "minimum_chrome_version": "114",
  "permissions": [
    "downloads",
    "scripting",
    "sidePanel",
    "storage",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://creator.xiaohongshu.com/*",
    "https://www.xiaohongshu.com/*",
    "https://api.deepseek.com/*",
    "https://api.openai.com/*",
    "https://api.moonshot.cn/*",
    "https://open.bigmodel.cn/*",
    "https://dashscope.aliyuncs.com/*",
    "https://api.siliconflow.cn/*",
    "https://api.mixpanel.com/*",
    "https://*.supabase.co/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://creator.xiaohongshu.com/statistics/*"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.xiaohongshu.com/explore/*",
        "https://www.xiaohongshu.com/discovery/item/*",
        "https://www.xiaohongshu.com/user/profile/*"
      ],
      "js": ["lib/data-store.js", "lib/error-classifier.js", "content/note-scraper.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background/background.js"
  }
}
